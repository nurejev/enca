        "Microsoft.Intune_RemoteTasks_Wipe",
        "Microsoft.Intune_RemoteTasks_Retire",
        "Microsoft.Intune_RemoteTasks_RotateBitLockerKeys",
        "Microsoft.Intune_RemoteTasks_RotateLocalAdminPassword",
