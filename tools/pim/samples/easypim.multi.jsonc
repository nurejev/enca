        "roleName": "Global Administrator",
        "assignments": [
          {
            "principalId": "<id of PIM-SG-M365-GlobalAdmin>",
            "principalName": "PIM-SG-M365-GlobalAdmin",
            "principalType": "Group",
            "assignmentType": "Eligible",
            "duration": "P365D",
            "justification": "CloudFellows PIM framework 5.0: PIM-SG-M365-GlobalAdmin carries Global Administrator"
