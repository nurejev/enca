  // The groups' PIM for Groups Member policy. GroupMember = every Entra role group since 5.0 (members ACTIVE, at most a year; the group eligible per role, so a person activates one role at a time, in seconds); GroupJIT = Intune, Defender XDR and Exchange access groups (members ELIGIBLE, activate for a shift); GroupJITTier0 = PIM-SG-XDR-Admin.
  "GroupRoles": {
    "Policies": {
      "PIM-SG-M365-GlobalAdmin": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-M365-SecOps": {
        "Member": {
          "Template": "GroupMember"
        }
      },
