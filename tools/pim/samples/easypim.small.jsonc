  // The groups' PIM for Groups Member policy. GroupJITTier1 = job groups (members ELIGIBLE, one activation of four hours gives the whole job); GroupMember = direct groups (members ACTIVE, at most a year, the roles eligible one at a time); GroupJIT = Intune, Defender XDR and Exchange access groups (members ELIGIBLE, activate for a shift); GroupJITTier0 = PIM-SG-XDR-Admin.
  "GroupRoles": {
    "Policies": {
      "PIM-SG-M365-GlobalAdmin": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-M365-SecOps": {
        "Member": {
          "Template": "GroupJITTier1"
        }
      },
      "PIM-SG-M365-SecOps-Direct": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-M365-Ops": {
        "Member": {
          "Template": "GroupJITTier1"
        }
      },
      "PIM-SG-M365-Ops-Direct": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-M365-SecOpsReader": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-EXO-Recipients": {
        "Member": {
          "Template": "GroupJIT"
        }
      },
      "PIM-SG-INT-Ops": {
        "Member": {
          "Template": "GroupJIT"
        }
      },
      "PIM-SG-INT-SecOps": {
        "Member": {
          "Template": "GroupJIT"
        }
      },
      "PIM-SG-XDR-Admin": {
        "Member": {
          "Template": "GroupJITTier0"
        }
      },
      "PIM-SG-XDR-Operator-T3": {
        "Member": {
          "Template": "GroupJIT"
        }
      },
      "PIM-SG-XDR-Reader": {
        "Member": {
          "Template": "GroupJIT"
        }
      },
      "PIM-SG-AZ-Tenant-Owner": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-AZ-Sub-Owner": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-AZ-Sub-Contributor": {
        "Member": {
          "Template": "GroupMember"
        }
      }
    }
  },
  "Assignments": {
    // The model: job groups hold their roles ACTIVE, permanently (assignmentType Active, permanent); direct groups are ELIGIBLE per role. Leave these; people never get a role directly.
    "EntraRoles": [
      {
        "roleName": "Global Administrator",
        "assignments": [
          {
            "principalId": "<id of PIM-SG-M365-GlobalAdmin>",
            "principalName": "PIM-SG-M365-GlobalAdmin",
            "principalType": "Group",
            "assignmentType": "Eligible",
            "duration": "P365D",
