      "PIM-SG-AZ-Tenant-Owner": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-AZ-Sub-Owner": {
        "Member": {
          "Template": "GroupMember"
        }
      },
      "PIM-SG-AZ-Sub-Contributor": {
        "Member": {
          "Template": "GroupMember"
        }
      }
    }
  },
