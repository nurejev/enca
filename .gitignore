.DS_Store
node_modules/

# Git lock files and temp objects that the Cowork device bridge cannot delete
# get moved here after each bridge-side commit; safe to empty at any time.
_to_delete/

# Tenant-specific auth override for a self-hosted single-tenant deployment.
# Never committed: it names YOUR client ID and tenant. See SINGLE-TENANT.md.
js/authConfig.local.js

# Retired per-audience demo — kept locally as offline reference only. The
# look lives in a local selfhost-branding.json for the customer's own
# self-hosting; none of it is published anymore (removed in beta 25196, production 297).
/pvm/
/assets/pvm/

# Dovilo branding — offline only, same rule as above: customer branding is
# never published from this repo. dovilo/selfhost-branding.json is theirs
# to serve on a self-hosted instance.
/dovilo/

# CloudFellows branding — offline only, same rule as above.
/cloudfellows/

# Terraform deployment of the self-hosting image — offline only. It names a
# subscription, a service connection and an app registration, and it is not
# an ENCA change: no changelog entry, no promotion-queue item, no build
# number. It is its own git repo pushed to Azure Repos, so the nested .git
# lives in here too. selfhost/azuredeploy.json stays the published route.
/terraform/

# Working notes that are deliberately NOT part of the repo. The tool
# consolidation plan (39 tiles down to 19, builds 25338-25349) and anything
# like it: written to be worked from and superseded, not to be kept. The
# record of what actually shipped is js/changelog.js, js/promote.js and the
# roadmap, which is where somebody reading the repo will look. Left untracked
# on purpose, so the pre-commit check stops asking about it.
/CONSOLIDATION-PLAN.md

# Review folders. Every review, audit and layout sweep lives under review/<date>/
# with its screenshots, browser JSON and probe output — 41 MB of evidence written
# to be read once and superseded. The record of what actually shipped is
# js/changelog.js, js/promote.js and the roadmap, which is where somebody reading
# the repo looks; and review/ was deliberately never ported to main anyway.
# Offline only, same rule as CONSOLIDATION-PLAN.md above.
/review/
